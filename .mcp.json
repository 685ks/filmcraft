{
  "mcpServers": {
    "filmcraft": {
      "command": "target/release/filmcraft-cli",
      "args": [
        "mcp",
        "--bridge",
        "127.0.0.1:9876"
      ],
      "env": {
        "FILMCRAFT_CONTROL_TOKEN_FILE": "${HOME}/.filmcraft-control.token"
      }
    },
    "filmcraft-headless": {
      "command": "target/release/filmcraft-cli",
      "args": [
        "mcp",
        "--demo"
      ]
    }
  }
}
